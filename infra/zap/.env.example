# Host-side ZAP API port read by FlowScope. Keep it on loopback.
FLOWSCOPE_ZAP_PORT=8089

# Burp SCANNER listener reachable from the ZAP container.
FLOWSCOPE_BURP_SCANNER_PORT=8081

# Do not commit a real key. scripts/zap-up.sh generates and mounts this owner-only file.
# FLOWSCOPE_ZAP_KEY_FILE=/absolute/path/to/.flowscope/zap-api-key
