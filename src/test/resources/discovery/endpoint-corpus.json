[
  {
    "name": "malformed-mpa-html",
    "scope": "https://fixture.test/app/",
    "documents": [
      {
        "path": "/app/index.html",
        "mediaType": "text/html",
        "body": "<!doctype html><base href='/app/v3/'><a href=orders/9>order<form action=search method=post><script>fetch('api/me'); fetch('/app/dynamic/'+id)</script><a href='https://outside.test/x'>outside</a>"
      }
    ],
    "expected": [
      "UNKNOWN /app/v3/orders/{id}",
      "POST /app/v3/search",
      "GET /app/v3/api/me",
      "GET /app/dynamic/{id}"
    ]
  },
  {
