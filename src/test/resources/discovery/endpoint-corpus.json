        "body": "axios.get('/app/api/orders/7'); const x=new XMLHttpRequest(); x.open('PATCH','/app/api/profile'); $.ajax({url:'/app/api/search',method:'POST'}); navigator.sendBeacon('/app/api/audit','x'); fetch('/app/api/dynamic/'+id);"
      }
