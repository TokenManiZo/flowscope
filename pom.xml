<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.flowscope</groupId>
  <artifactId>flowscope</artifactId>
  <version>1.2.0-beta.3</version>
  <packaging>jar</packaging>

  <name>FlowScope</name>
  <description>Differential HUMAN/SCANNER/LLM authorization analysis inside Burp Suite</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <montoya.version>2026.7</montoya.version>
    <junit.version>5.11.4</junit.version>
    <jackson.version>2.22.2</jackson.version>
    <project.build.outputTimestamp>2026-08-24T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencies>
    <!-- Burp Montoya API: provided by Burp at runtime, compile-only here -->
    <dependency>
      <groupId>net.portswigger.burp.extensions</groupId>
      <artifactId>montoya-api</artifactId>
      <version>${montoya.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Local MCP JSON-RPC transport. Relocated in the fat JAR to avoid Burp extension conflicts. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>flowscope-${project.version}</finalName>
    <plugins>
      <!-- Fat JAR: bundle runtime dependencies and web assets (Montoya is provided by Burp). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/NOTICE</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <!-- The shaded JAR is not multi-release; keep only the relocated base classes. -->
                    <exclude>META-INF/versions/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>io.flowscope.shaded.jackson</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <!-- Burp discovers and instantiates the Montoya extension through the JAR entry point. -->
                  <mainClass>io.flowscope.burp.FlowScopeExtension</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- convenience: `mvn exec:java` runs the standalone local web workspace -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>io.flowscope.Standalone</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
