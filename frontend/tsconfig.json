{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "target": "ESNext",
    "tsBuildInfoFile": "../target/tsbuildinfo/react-web.tsbuildinfo",
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
