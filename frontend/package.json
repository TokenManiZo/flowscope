{
  "name": "flowscope-web",
  "private": true,
  "version": "1.2.0-beta.25",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-react-output.mjs && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude scripts/generate-notices.test.mjs",
    "test:watch": "vitest --exclude scripts/generate-notices.test.mjs",
    "verify": "npm run typecheck && npm run test",
    "test:incremental-package": "node --test scripts/incremental-package-assets.node-test.mjs",
    "verify:incremental-package": "npm run test:incremental-package && node scripts/verify-incremental-package.mjs",
    "e2e": "playwright test",
    "notices": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cytoscape": "3.34.2",
    "lucide-react": "1.38.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/cytoscape": "3.31.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.0.1",
    "license-checker-rseidelsohn": "5.0.1",
    "shadcn": "4.19.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
